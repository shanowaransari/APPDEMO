<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/login_bg">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="22dp"
      android:paddingBottom="35dp">

    <!-- Back -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:padding="9dp"
        android:src="@drawable/baseline_arrow_back_24"
        android:contentDescription="Back" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="150dp"
        android:layout_height="143dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:contentDescription="SanketSetu"
        android:scaleType="fitCenter"
        android:src="@drawable/app_logo" />

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="SanketSetu"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#29206E"
        android:fontFamily="sans" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:text="Digital Indian Sign Language"
        android:textSize="13sp"
        android:textColor="#68658A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Communication Assistant"
        android:textSize="13sp"
        android:textColor="#68658A" />

    <!-- AI Tag -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:gravity="center"
        android:background="@drawable/ai_badge">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="✦  AI Powered Communication"
          android:textSize="11sp"
          android:textStyle="bold"
          android:textColor="#4A20C8" />

    </LinearLayout>


    <!-- ================= CARD ================= -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#FDFCFF"
        app:cardUseCompatPadding="true">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="22dp">

        <!-- Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back 👋"
            android:textAlignment="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2F1B8F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Sign in to continue your journey"
            android:textAlignment="center"
            android:textSize="14sp"
            android:textColor="#77758A" />


        <!-- Email -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#37325B"
            android:layout_marginBottom="7dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/ai_input">

          <ImageView
              android:layout_width="25dp"
              android:layout_height="25dp"
              android:src="@drawable/baseline_email_24"
              android:padding="3dp"
              android:contentDescription="Email" />

          <EditText
              android:id="@+id/etEmail"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:layout_marginStart="11dp"
              android:hint="Enter your email"
              android:textSize="15sp"
              android:textColor="#29263A"
              android:textColorHint="#A19FB0"
              android:inputType="textEmailAddress"
              android:background="@android:color/transparent"
              android:singleLine="true" />

        </LinearLayout>


        <!-- Password -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="7dp"
            android:text="Password"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#37325B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="7dp"
            android:background="@drawable/ai_input">

          <ImageView
              android:layout_width="25dp"
              android:layout_height="25dp"
              android:src="@drawable/outline_lock_24"
              android:padding="3dp"
              android:contentDescription="Password" />

          <EditText
              android:id="@+id/etPassword"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:layout_marginStart="11dp"
              android:hint="Enter your password"
              android:textSize="15sp"
              android:textColor="#29263A"
              android:textColorHint="#A19FB0"
              android:inputType="textPassword"
              android:background="@android:color/transparent"
              android:singleLine="true" />

          <ImageView
              android:id="@+id/ivPasswordEye"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:padding="9dp"
              android:src="@drawable/ic_visibility_off"
              android:contentDescription="Show password" />

        </LinearLayout>


        <!-- Forgot -->

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:text="Forgot Password?"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#5424CF"
            android:clickable="true"
            android:focusable="true" />


        <!-- Login -->

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="19dp"
            android:gravity="center"
            android:text="Login  →"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/ai_login_button"
            android:clickable="true"
            android:focusable="true" />


        <!-- Divider -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

          <View
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1"
              android:background="#E5E2EF" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:paddingStart="12dp"
              android:paddingEnd="12dp"
              android:text="or continue with"
              android:textSize="12sp"
              android:textColor="#9693A5" />

          <View
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1"
              android:background="#E5E2EF" />

        </LinearLayout>


        <!-- Social Buttons -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

          <LinearLayout
              android:id="@+id/btnGoogle"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:gravity="center"
              android:background="@drawable/ai_social_button"
              android:clickable="true"
              android:focusable="true">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/google_logo"
                android:contentDescription="Google" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Google"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#39354C" />

          </LinearLayout>


          <Space
              android:layout_width="10dp"
              android:layout_height="1dp" />


          <LinearLayout
              android:id="@+id/btnPhone"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:gravity="center"
              android:background="@drawable/ai_social_button"
              android:clickable="true"
              android:focusable="true">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/baseline_call_24"
                android:contentDescription="Phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Phone"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#39354C" />

          </LinearLayout>

        </LinearLayout>


        <!-- Register -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center"
            android:orientation="horizontal">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="New to SanketSetu? "
              android:textSize="13sp"
              android:textColor="#858292" />

          <TextView
              android:id="@+id/tvRegister"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Create Account"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="#4E20C7"
              android:clickable="true"
              android:focusable="true" />

        </LinearLayout>

      </LinearLayout>

    </androidx.cardview.widget.CardView>

  </LinearLayout>

</ScrollView>