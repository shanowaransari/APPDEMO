<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ===================================================== -->
    <!-- MAIN APP AREA -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="30dp">

        <!-- ================================================= -->
        <!-- FIXED TOP ACTION BAR -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F5EEFF"
            android:elevation="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- HAMBURGER -->

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/outline_menu_24"
                android:tint="#5B2C9E"
                android:contentDescription="Menu" />


            <!-- CENTER LOGO + NAME -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgToolbarLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/app_logo"
                    android:contentDescription="SanketSetu Logo" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="SanketSetu"
                    android:textColor="#5B2C9E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- NOTIFICATION -->

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/btnNotification"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/outline_notifications_24"
                    android:tint="#5B2C9E"
                    android:contentDescription="Notifications" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/notification_dot" />

            </FrameLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SCROLLABLE CONTENT -->
        <!-- ================================================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- WELCOME SECTION -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/header_bg"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back,"
                        android:textColor="#3A3A50"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvWelcomeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Shanowar 👋"
                        android:textColor="#5B2C9E"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Let's bridge communication&#10;beyond words. 💜"
                        android:textColor="#5A5470"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- MAIN CONTENT -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">


                    <!-- QUICK ACCESS TITLE -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Access"
                        android:textColor="#2B2740"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/arrow_circle_purple" />


                    <!-- ================================================= -->
                    <!-- ROW 1 -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="18dp"
                        android:baselineAligned="false">


                        <!-- SIGN TO TEXT -->

                        <LinearLayout
                            android:id="@+id/cardSignToText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/card_bg_sign"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/outline_back_hand_24"
                                android:tint="#7B4FE0"
                                android:contentDescription="Sign to Text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Sign → Text"
                                android:textColor="#5B2C9E"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Convert sign to text"
                                android:textColor="#4A4460"
                                android:textSize="10.5sp" />

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="10dp"
                                android:padding="6dp"
                                android:background="@drawable/arrow_circle_purple"
                                android:src="@drawable/outline_arrow_forward_24"
                                android:tint="#FFFFFF"
                                android:contentDescription="Go" />

                        </LinearLayout>


                        <!-- TEXT TO SIGN -->

                        <LinearLayout
                            android:id="@+id/cardTextToSign"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/card_bg_text"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/baseline_textsms_24"
                                android:tint="#3F7FE0"
                                android:contentDescription="Text to Sign" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Text → Sign"
                                android:textColor="#3F7FE0"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Convert text to sign"
                                android:textColor="#4A4460"
                                android:textSize="10.5sp" />

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="10dp"
                                android:padding="6dp"
                                android:background="@drawable/arrow_circle_blue"
                                android:src="@drawable/outline_arrow_forward_24"
                                android:tint="#FFFFFF"
                                android:contentDescription="Go" />

                        </LinearLayout>


                        <!-- VOICE TO SIGN -->

                        <LinearLayout
                            android:id="@+id/cardVoiceToSign"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/card_bg_voice"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/outline_mic_24"
                                android:tint="#2EA36B"
                                android:contentDescription="Voice to Sign" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Voice → Sign"
                                android:textColor="#2EA36B"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Speak and get sign"
                                android:textColor="#4A4460"
                                android:textSize="10.5sp" />

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="10dp"
                                android:padding="6dp"
                                android:background="@drawable/arrow_circle_green"
                                android:src="@drawable/outline_arrow_forward_24"
                                android:tint="#FFFFFF"
                                android:contentDescription="Go" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- ROW 2 -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false">


                        <!-- EMERGENCY -->

                        <LinearLayout
                            android:id="@+id/cardEmergency"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/card_bg_emergency"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/outline_e911_emergency_24"
                                android:tint="#E0526B"
                                android:contentDescription="Emergency" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Emergency"
                                android:textColor="#E0526B"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Quick communication for urgent situations"
                                android:textColor="#4A4460"
                                android:textSize="10.5sp" />

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="10dp"
                                android:padding="6dp"
                                android:background="@drawable/arrow_circle_red"
                                android:src="@drawable/outline_arrow_forward_24"
                                android:tint="#FFFFFF"
                                android:contentDescription="Go" />

                        </LinearLayout>
                        <!-- ================= CARD 5: LEARN ISL ================= -->

                        <LinearLayout
                            android:id="@+id/cardLearnISL"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/card_bg_learn"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/outline_book_5_24"
                                android:tint="#E09A28"
                                android:contentDescription="Learn ISL" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Learn ISL"
                                android:textColor="#D89020"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Learn Indian Sign Language"
                                android:textColor="#4A4460"
                                android:textSize="10.5sp" />

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="10dp"
                                android:padding="6dp"
                                android:background="@drawable/arrow_circle_orange"
                                android:src="@drawable/outline_arrow_forward_24"
                                android:tint="#FFFFFF"
                                android:contentDescription="Go" />

                        </LinearLayout>


                        <!-- ================= CARD 6: PRACTICE ================= -->

                        <LinearLayout
                            android:id="@+id/cardPractice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="@drawable/card_bg_practice"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/outline_mindfulness_24"
                                android:tint="#7B4FE0"
                                android:contentDescription="Practice" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Practice"
                                android:textColor="#7B4FE0"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Practice &amp; test your skills"
                                android:textColor="#4A4460"
                                android:textSize="10.5sp" />

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="10dp"
                                android:padding="6dp"
                                android:background="@drawable/arrow_circle_purple"
                                android:src="@drawable/outline_arrow_forward_24"
                                android:tint="#FFFFFF"
                                android:contentDescription="Go" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- ================= LEARNING BANNER ================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/banner_bg"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/outline_target_24"
                            android:tint="#7B4FE0"
                            android:contentDescription="Learning" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Keep Learning, Keep Growing! 🌟"
                                android:textColor="#5B2C9E"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Practice daily and improve your communication skills."
                                android:textColor="#4A4460"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnLetsGo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/btn_letsgo"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="Let's Go!"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <!-- =====================================================
             BOTTOM NAVIGATION
             ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/outline_home_24"
                    android:tint="#7B4FE0"
                    android:contentDescription="Home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Home"
                    android:textColor="#7B4FE0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- LEARN -->

            <LinearLayout
                android:id="@+id/navLearn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/outline_book_5_24"
                    android:tint="#8A8494"
                    android:contentDescription="Learn" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Learn"
                    android:textColor="#8A8494"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- SCAN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/navScan"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/scan_bg"
                    android:src="@drawable/outline_qr_code_scanner_24"
                    android:tint="#FFFFFF"
                    android:scaleType="center"
                    android:contentDescription="Scan" />

            </LinearLayout>


            <!-- HISTORY -->

            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/outline_history_24"
                    android:tint="#8A8494"
                    android:contentDescription="History" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="History"
                    android:textColor="#8A8494"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- PROFILE -->

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/outline_person_24"
                    android:tint="#8A8494"
                    android:contentDescription="Profile" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Profile"
                    android:textColor="#8A8494"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    <!-- ================= LEFT MENU DRAWER ================= -->

    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="16dp">

        <!-- Drawer Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/header_bg"
            android:padding="20dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/app_logo"
                android:contentDescription="SanketSetu Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SanketSetu"
                android:textColor="#5B2C9E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Let's bridge communication 💜"
                android:textColor="#5A5470"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- My Profile -->

        <TextView
            android:id="@+id/menuProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:text="👤   My Profile"
            android:textColor="#302A40"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />


        <!-- Notifications -->

        <TextView
            android:id="@+id/menuNotifications"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:text="🔔   Notifications"
            android:textColor="#302A40"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />


        <!-- Settings -->

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:text="⚙️   Settings"
            android:textColor="#302A40"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />


        <!-- About -->

        <TextView
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:text="ℹ️   About SanketSetu"
            android:textColor="#302A40"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#EEEEEE" />


        <!-- Logout -->

        <TextView
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:text="🚪   Logout"
            android:textColor="#D94B5B"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

